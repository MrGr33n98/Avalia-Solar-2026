NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Groups permanece fechado até validação de backend e staging.
NEXT_PUBLIC_GROUPS_ENABLED=false

# Environment
NEXT_PUBLIC_ENV=development

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Next.js Security
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Shared secret used only by the Rails backend to invalidate public profile ISR.
# Must match NEXT_REVALIDATE_SECRET in the backend deployment; never expose it
# with the NEXT_PUBLIC_ prefix.
NEXT_REVALIDATE_SECRET=
# In production, enable only after `wss://<api-host>/cable` returns HTTP 101.
# Keep unset locally: localhost is enabled automatically.
# NEXT_PUBLIC_ENABLE_REALTIME=false

# PWA offline/mobile service worker (Sprint 1/PWA-TASK-015).
# When true, registers /sw.js and enables offline queue on supported routes.
# Must be true in CI for PWA E2E tests to pass.
NEXT_PUBLIC_ENABLE_MOBILE_OFFLINE=false

# Task-006: Sentry Configuration
# Get your DSN from: https://sentry.io/settings/[organization]/projects/[project]/keys/
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Sentry Organization and Project (for source map uploads)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Release tracking
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_BUILD_ID=

# Google Analytics 4
# Get from: https://analytics.google.com/ → Admin → Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Enable/disable analytics (default: false in dev)
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# New Relic Browser — client-side RUM (disabled by default)
# Configure per environment; never use the private Rails APM license here.
NEXT_PUBLIC_NEW_RELIC_BROWSER_ENABLED=false
NEXT_PUBLIC_NEW_RELIC_ACCOUNT_ID=
NEXT_PUBLIC_NEW_RELIC_APPLICATION_ID=
NEXT_PUBLIC_NEW_RELIC_BROWSER_LICENSE_KEY=
NEXT_PUBLIC_NEW_RELIC_TRUST_KEY=
NEXT_PUBLIC_NEW_RELIC_AGENT_ID=
NEXT_PUBLIC_NEW_RELIC_ENVIRONMENT=
NEXT_PUBLIC_NEW_RELIC_RELEASE=

# PostHog — Product Analytics, Feature Flags, Session Recording, Intent Tracking
# Project API Key: https://app.posthog.com/project/settings → Project API Key
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_GTM_ID=GTM-5RV76ZKR
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_NUTSHELL_INSTANCE=385068
NEXT_PUBLIC_NUTSHELL_AUTH_TOKEN=KTE-7awqaTLwXH6lG6jbzAyKyC6DbZ8vNQBtAACppQg.2

# Sprint 2 — Offline foundation / service worker
# Default behavior: enabled outside production when unset.
NEXT_PUBLIC_ENABLE_MOBILE_OFFLINE=false
NEXT_PUBLIC_CHAT_ENABLED=true

# Home category carousel rollout. Disabled by default.
home_category_carousel_enabled=false

# Contato WhatsApp suporte Review Dashboard (URL completa)
NEXT_PUBLIC_SUPPORT_WHATSAPP=
