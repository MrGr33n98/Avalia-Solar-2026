{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean:next": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true });\"",
    "dev:clean": "npm run clean:next && next dev",
    "build": "next build",
    "postbuild": "node script/warm-home-cache.mjs || echo \"cache warm skipped\"",
    "build:clean": "npm run clean:next && next build",
    "analyze": "cross-env ANALYZE=true NODE_OPTIONS=\"--max-old-space-size=4096\" next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_ENV=development jest",
    "test:watch": "cross-env NODE_ENV=development jest --watch",
    "test:coverage": "cross-env NODE_ENV=development jest --coverage",
    "test:ci": "cross-env NODE_ENV=development jest --ci --coverage --maxWorkers=2",
    "knip": "knip",
    "perf:lhci": "npx @lhci/cli@0.14.x autorun --config=./lighthouserc.json",
    "perf:warm-cache": "node script/warm-home-cache.mjs",
    "perf:simulate-cache-fallback": "node script/simulate-home-cache-fallback.mjs"
  },
