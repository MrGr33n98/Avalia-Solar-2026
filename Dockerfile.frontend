# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Add package files (monorepo: frontend lives in AB0-1-front)
COPY AB0-1-front/package.json ./

# Install dependencies with retry mechanism
RUN --mount=type=cache,target=/root/.npm \
    npm config set registry https://registry.npmjs.org/ && \
    npm config set fetch-retry-maxtimeout 600000 && \
    npm config set fetch-retry-mintimeout 10000 && \
    npm config set fetch-retries 5 && \
    npm install -g npm@10.2.4 && \
    npm install --legacy-peer-deps --no-audit --network-timeout=600000

# Add app files (only frontend)
COPY AB0-1-front/ .

# Build app
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_DISABLE_WEBPACK_CACHE=1
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=1536"

# Fail fast with a clear error if build script is missing
RUN node -e "const p=require('./package.json'); if(!p.scripts||!p.scripts.build){console.error('ERROR: Missing scripts.build in AB0-1-front/package.json'); process.exit(1)}" \
  && npm run build || (echo "ERROR: npm run build failed. Check TypeScript errors and ensure dependencies installed." >&2 && exit 1) \
  && rm -rf .next/cache

# Production stage
FROM node:20-alpine

WORKDIR /app

# Copy built assets
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/next.config.js ./next.config.js
COPY --from=builder /app/node_modules ./node_modules

# Set production environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Start the app with standalone configuration
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
CMD ["node", "server.js"]
