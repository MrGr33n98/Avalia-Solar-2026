# Build stage
FROM node:20-alpine AS builder

# Instala bash para ter um shell mais robusto que o sh padrão do Alpine
RUN apk add --no-cache bash

# Usa bash como shell padrão para todos os comandos RUN, COPY, etc.
# Isso garante que `set -euo pipefail` funcione de forma confiável.
SHELL ["bash", "-c"]

WORKDIR /app

# --- Variáveis de Ambiente para o Build ---
# Define ARGs que podem ser passados pelo `docker build --build-arg`.
# Fornece valores padrão seguros para o caso de não serem passados.
ARG NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
ARG NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"
ARG NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ARG NEXT_PUBLIC_ENABLE_ANALYTICS="true"
ARG NEXT_PUBLIC_GTM_ID="GTM-5RV76ZKR"
ARG NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
ARG NEXT_PUBLIC_LINKEDIN_CLIENT_ID=""
ARG SENTRY_AUTH_TOKEN=""
ARG SENTRY_ORG=""
ARG SENTRY_PROJECT=""
ARG NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="p1OVlbHjjYrpDOq7mSMziD6CKXQBa56Wq-02J5ow7go"

# Copia os manifestos de dependência primeiro para aproveitar o cache do Docker
COPY AB0-1-front/package.json AB0-1-front/package-lock.json ./

# Instala dependências de forma limpa e otimizada para CI/CD
# `npm ci` é mais rápido e seguro que `npm install` para builds.
RUN --mount=type=cache,target=/root/.npm \
    npm config set registry https://registry.npmjs.org/ && \
    npm ci --legacy-peer-deps --no-audit

# Copia o restante do código da aplicação
COPY AB0-1-front/ .

# Limpa builds anteriores para garantir um build limpo
RUN rm -rf .next

# --- Configurações de Build ---
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
# Aumenta a memória disponível para o processo de build do Next.js para 4GB
ENV NODE_OPTIONS="--max-old-space-size=4096"
# Sentry variables (optional - only used if provided)
ENV SENTRY_AUTH_TOKEN=${SENTRY_AUTH_TOKEN}
ENV SENTRY_ORG=${SENTRY_ORG}
ENV SENTRY_PROJECT=${SENTRY_PROJECT}
ENV NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=${NEXT_SERVER_ACTIONS_ENCRYPTION_KEY}
# Expose build-time environment variables to Next.js
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_ENABLE_ANALYTICS=${NEXT_PUBLIC_ENABLE_ANALYTICS}
ENV NEXT_PUBLIC_GTM_ID=${NEXT_PUBLIC_GTM_ID}
ENV NEXT_PUBLIC_BETTER_AUTH_URL=${NEXT_PUBLIC_BETTER_AUTH_URL}
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=${NEXT_PUBLIC_GOOGLE_CLIENT_ID}
ENV NEXT_PUBLIC_LINKEDIN_CLIENT_ID=${NEXT_PUBLIC_LINKEDIN_CLIENT_ID}

# --- Build da Aplicação ---
# Valida variáveis de ambiente críticas antes do build
RUN set -euo pipefail; \
    echo "📦 Building Next.js app..."; \
    echo "Node version: $(node -v)"; \
    echo "NPM version: $(npm -v)"; \
    echo ""; \
    echo "Environment variables:"; \
    echo "  NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}"; \
    echo "  NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}"; \
    echo "  NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}"; \
    echo "  NEXT_PUBLIC_ENABLE_ANALYTICS=${NEXT_PUBLIC_ENABLE_ANALYTICS}"; \
    echo "  NEXT_PUBLIC_GTM_ID=${NEXT_PUBLIC_GTM_ID}"; \
    echo "  NODE_ENV=${NODE_ENV}"; \
    echo ""; \
    if [ -z "${NEXT_PUBLIC_API_URL}" ] || [ -z "${NEXT_PUBLIC_SITE_URL}" ]; then \
        echo "❌ ERROR: Required environment variables are not set" >&2; \
        echo "  NEXT_PUBLIC_API_URL and NEXT_PUBLIC_SITE_URL must be set" >&2; \
        exit 1; \
    fi; \
    echo "✅ Environment variables validated"; \
    echo ""; \
    echo "📝 Running TypeScript check..."; \
    npx tsc --noEmit || echo "⚠️  TypeScript check warnings (continuing build)"; \
    echo ""; \
    echo "🔨 Building Next.js application..."; \
    npm run build 2>&1 | tee /tmp/build.log || ( \
        echo "" >&2; \
        echo "❌ ERROR: npm run build failed with exit code $?" >&2; \
        echo "========================================" >&2; \
        echo "Last 100 lines of build output:" >&2; \
        echo "========================================" >&2; \
        tail -100 /tmp/build.log 2>/dev/null || cat /tmp/build.log 2>/dev/null || echo "No build log available" >&2; \
        echo "========================================" >&2; \
        exit 1; \
    ); \
    echo ""; \
    echo "✅ Build completed successfully"

# Production stage
FROM node:20-alpine

WORKDIR /app

# --- Variáveis de Ambiente de Runtime ---
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ARG NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="p1OVlbHjjYrpDOq7mSMziD6CKXQBa56Wq-02J5ow7go"
ENV NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=${NEXT_SERVER_ACTIONS_ENCRYPTION_KEY}

# Copia os artefatos de build da etapa anterior
COPY --from=builder /app/public ./public
# Copia TODA a pasta .next para garantir que nada falte
COPY --from=builder /app/.next ./.next
# Copia a aplicação standalone gerada pelo `output: 'standalone'` no next.config.js
COPY --from=builder /app/.next/standalone ./

EXPOSE 3000

CMD ["node", "server.js"]
