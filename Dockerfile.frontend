# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Add package files
COPY AB0-1-front/package.json ./

# Install dependencies
RUN --mount=type=cache,target=/root/.npm \
    npm config set registry https://registry.npmjs.org/ && \
    npm install -g npm@10.2.4 && \
    npm install --legacy-peer-deps --no-audit

# Add app files
COPY AB0-1-front/ .

# Limpa builds anteriores
RUN rm -rf .next

# Limpa builds anteriores
RUN rm -rf .next

# Build configurations
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=1536"

# Build app com logs
RUN set -euo pipefail; \
  echo "🔍 DEBUG: Checking package.json in $(pwd)..."; \
  ls -la package.json; \
  cat package.json; \
  node -e "const p=require('./package.json'); if(!p.scripts||!p.scripts.build){console.error('ERROR: Missing scripts.build'); console.log('Current scripts:', p.scripts); process.exit(1)}"; \
  (npm run build 2>&1 | tee /tmp/next-build.log) || ( \
    echo "❌ ERROR: npm run build falhou. Mostrando logs finais:" >&2; \
    tail -n 100 /tmp/next-build.log >&2; \
    exit 1; \
  )

# Production stage
FROM node:20-alpine

WORKDIR /app

# Runtime envs
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

# Copia artefatos do builder
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/.next/standalone ./

EXPOSE 3000

CMD ["node", "server.js"]