# Stage 1: Install dependencies
FROM node:20-bookworm-slim AS deps
WORKDIR /app

# Install dependencies based on the preferred package manager
COPY AB0-1-front/package.json AB0-1-front/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --legacy-peer-deps --no-audit

# Stage 2: Rebuild the source code only when needed
FROM node:20-bookworm-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY AB0-1-front/ .

# Fix for OpenTelemetry/require-in-the-middle warnings
RUN npm install --no-save require-in-the-middle module-details-from-path

# --- Variáveis de Ambiente para o Build ---
# Variáveis públicas (seguras para ENV, embutidas no JS)
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_ENABLE_ANALYTICS
ARG NEXT_PUBLIC_GTM_ID
ARG NEXT_PUBLIC_BETTER_AUTH_URL
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
ARG NEXT_PUBLIC_LINKEDIN_CLIENT_ID

# Variáveis sensíveis (Usamos secrets durante o build para evitar exposição e avisos de segurança)
# ARG NEXT_SERVER_ACTIONS_ENCRYPTION_KEY
# ARG BETTER_AUTH_SECRET
# ARG SENTRY_AUTH_TOKEN
ARG SENTRY_ORG
ARG SENTRY_PROJECT

# Exportamos apenas as variáveis públicas para o ENV
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL} \
    NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL} \
    NEXT_PUBLIC_ENABLE_ANALYTICS=${NEXT_PUBLIC_ENABLE_ANALYTICS} \
    NEXT_PUBLIC_GTM_ID=${NEXT_PUBLIC_GTM_ID} \
    NEXT_PUBLIC_BETTER_AUTH_URL=${NEXT_PUBLIC_BETTER_AUTH_URL} \
    NEXT_PUBLIC_GOOGLE_CLIENT_ID=${NEXT_PUBLIC_GOOGLE_CLIENT_ID} \
    NEXT_PUBLIC_LINKEDIN_CLIENT_ID=${NEXT_PUBLIC_LINKEDIN_CLIENT_ID} \
    NEXT_TELEMETRY_DISABLED=1 \
    OTEL_SDK_DISABLED=true \
    NODE_ENV=production \
    SENTRY_SKIP_UPLOAD=1 \
    SENTRY_IGNORE_API_ERRORS=1

# Validação básica para evitar builds quebrados por falta de env vars críticas
# Nota: Validamos as secrets montadas no passo de build abaixo

# Rodar o build com as variáveis sensíveis passadas via mount=secret
# Memória limitada a 6GB para evitar OOM Killer em runners do GitHub (7GB total)
RUN --mount=type=secret,id=NEXT_SERVER_ACTIONS_ENCRYPTION_KEY \
    --mount=type=secret,id=BETTER_AUTH_SECRET \
    --mount=type=secret,id=SENTRY_AUTH_TOKEN,required=false \
    NODE_OPTIONS='--max-old-space-size=6144' \
    NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="$(cat /run/secrets/NEXT_SERVER_ACTIONS_ENCRYPTION_KEY 2>/dev/null || echo '')" \
    BETTER_AUTH_SECRET="$(cat /run/secrets/BETTER_AUTH_SECRET 2>/dev/null || echo '')" \
    SENTRY_AUTH_TOKEN="$(cat /run/secrets/SENTRY_AUTH_TOKEN 2>/dev/null || echo '')" \
    SENTRY_ORG="${SENTRY_ORG}" \
    SENTRY_PROJECT="${SENTRY_PROJECT}" \
    NEXT_DISABLE_SOURCEMAPS=1 \
    npm run build

# Stage 3: Production image, copy all the files and run next
FROM node:20-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    OTEL_SDK_DISABLED=true \
    PORT=3000 \
    HOSTNAME="0.0.0.0"

RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 nextjs

COPY --from=builder /app/public ./public

# Set the correct permission for prerender cache
RUN mkdir .next && chown nextjs:nodejs .next

# Automatically leverage output traces to reduce image size
# https://nextjs.org/docs/advanced-features/output-file-tracing
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Manually copy static files to standalone if not already there (fallback for safety)
RUN cp -r /app/public/. . || true

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
