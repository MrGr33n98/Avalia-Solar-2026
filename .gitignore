# ############################
# Avalia Solar 2026 - .gitignore
# ############################

# Core Monorepo
node_modules/
.pnp/
.pnp.js
coverage/
.next/
out/
build/
dist/
*.log
.turbo/

# TypeScript
*.tsbuildinfo

# Environment / Secrets
.env
.env.local
.env.*.local
.env.*        # ignora env variantes
!.env.example # mas mantém o exemplo versionado

*.key
*.pem

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
*.tmp
*.cache

# AI tools / Local tooling
.aios*
.antigravity/
.claude/
.gemini/
.qwen/
.codex/
.cursor/
.opencode*
.spec-workflow/
.interface-design/
.playwright/
.bolt/

# Test artifacts
test-artifacts/
playwright-report/
test-results/
test-sentinel/
.playwright-cli/
logs/
*.webm
screenshot.png
error_*.png

# Backups & Archive
archive/
backup_limpeza_*/
outputs/
tmp/

# ############################
# Frontend (AB0-1-front)
# ############################
/AB0-1-front/node_modules/
/AB0-1-front/.env*
/AB0-1-front/.next/
/AB0-1-front/out/
/AB0-1-front/dist/
/AB0-1-front/cypress/videos/
/AB0-1-front/cypress/screenshots/

# ############################
# Backend (AB0-1-back)
# ############################
/AB0-1-back/log/
/AB0-1-back/tmp/
/AB0-1-back/storage/
/AB0-1-back/vendor/
/AB0-1-back/.bundle/
/AB0-1-back/config/master.key
/AB0-1-back/.env*
/AB0-1-back/db/*.sqlite3
/AB0-1-back/db/*.sqlite3-journal
