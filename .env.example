# ============================================
# Synkra AIOS Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env with real credentials
# ============================================

# --------------------------------------------
# LLM Providers
# --------------------------------------------

# DeepSeek API (for claude-free command)
# Get your key at: https://platform.deepseek.com/api_keys
# Cost: ~$0.14/M tokens with tool calling support
DEEPSEEK_API_KEY=

# OpenRouter API (for multi-model routing)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic API (direct, if not using Claude Max subscription)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --------------------------------------------
# Search & Research Tools
# --------------------------------------------

# Exa Search API (web search for agents)
# Get your key at: https://exa.ai/
EXA_API_KEY=

# Context7 (library documentation lookup)
# Usually free, no key required for basic usage
CONTEXT7_API_KEY=

# --------------------------------------------
# Database & Backend
# --------------------------------------------

# Supabase (database, auth, storage)
# Get from your Supabase project settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------
# Version Control & CI/CD
# --------------------------------------------

# GitHub Token (for GitHub CLI and API access)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# --------------------------------------------
# Project Management
# --------------------------------------------

# ClickUp API (if using ClickUp integration)
# Get from: ClickUp Settings > Apps > API Token
CLICKUP_API_KEY=

# --------------------------------------------
# Automation & Workflows
# --------------------------------------------

# N8N (workflow automation)
# From your N8N instance settings
N8N_API_KEY=
N8N_WEBHOOK_URL=

# --------------------------------------------
# Monitoring & Analytics
# --------------------------------------------

# Sentry (error tracking)
SENTRY_DSN=

# --------------------------------------------
# Cloud Providers
# --------------------------------------------

# Railway (deployment)
RAILWAY_TOKEN=

# Vercel (deployment)
VERCEL_TOKEN=

# --------------------------------------------
# AIOS Core Configuration
# --------------------------------------------
NODE_ENV=development
AIOS_VERSION=2.2.0

# Groups fechado por padrão; habilitar explicitamente no runtime de produção.
GROUPS_ENABLED=false

# --------------------------------------------
# Next.js & Better Auth Security
# --------------------------------------------
# Cryptographically random strings (min 32 chars)
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=

# --------------------------------------------
# Custom Configuration
# --------------------------------------------
# Add your custom API keys below

# ── PostHog (Product Analytics) ──────────────
# Get from: https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
POSTHOG_API_KEY=phxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_WEBHOOK_SECRET=your_webhook_secret_here

# ── n8n (Growth Orchestration) ───────────────
N8N_WEBHOOK_URL=https://n8n.avaliasolar.com.br/webhook/posthog-event
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret

# n8n Workflow IDs (after importing workflows)
WF_025_ID=
WF_030_ID=
WF_031_ID=

# ── Nutshell CRM ─────────────────────────────
# Get from: Nutshell → Settings → My account → API key
NUTSHELL_API_URL=https://app.nutshell.com/api/v1/json
NUTSHELL_EMAIL=your-email@company.com
NUTSHELL_API_KEY=your_nutshell_api_key

# ── Evolution API (WhatsApp) ─────────────────
EVOLUTION_API_URL=https://evolution.avaliasolar.com.br
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE_NAME=avaliasolar

# ── NewsAPI.org ──────────────────────────────
NEWS_API_KEY=your_newsapi_key

# ── Telegram Bot ─────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-DEFxxxxxxxxxxxx
TELEGRAM_GROWTH_ALERTS_CHAT_ID=-100xxxxxxxxxx

STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_BILLING_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_BILLING_WEBHOOK_URL=https://hooks.slack.com/services/xxxxxxxxx/xxxxxxxxx/xxxxxxxxx

# ── Outbound & Mobilidade Elétrica (Hermes Growth Engine) ──
PROSPEO_API_KEY=your_prospeo_api_key
META_INSTAGRAM_TOKEN=your_meta_instagram_graph_token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxxxxxxx/xxxxxxxxx/xxxxxxxxx
GMAIL_API_KEY=your_gmail_api_key_or_password
SMARTLEAD_API_KEY=your_smartlead_api_key


# SES & SNS Configuration
AWS_REGION=us-east-2
AWS_SES_CONFIGURATION_SET=avalia-solar-crm
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-2:431636668039:avalia-solar-ses-events
