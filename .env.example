# ============================================
# Synkra AIOS Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env with real credentials
# ============================================

# --------------------------------------------
# LLM Providers
# --------------------------------------------

# DeepSeek API (for claude-free command)
# Get your key at: https://platform.deepseek.com/api_keys
# Cost: ~$0.14/M tokens with tool calling support
DEEPSEEK_API_KEY=

# OpenRouter API (for multi-model routing)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic API (direct, if not using Claude Max subscription)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --------------------------------------------
# Search & Research Tools
# --------------------------------------------

# Exa Search API (web search for agents)
# Get your key at: https://exa.ai/
EXA_API_KEY=

# Context7 (library documentation lookup)
# Usually free, no key required for basic usage
CONTEXT7_API_KEY=

# --------------------------------------------
# Database & Backend
# --------------------------------------------

# Supabase (database, auth, storage)
# Get from your Supabase project settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------
# Version Control & CI/CD
# --------------------------------------------

# GitHub Token (for GitHub CLI and API access)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# --------------------------------------------
# Project Management
# --------------------------------------------

# ClickUp API (if using ClickUp integration)
# Get from: ClickUp Settings > Apps > API Token
CLICKUP_API_KEY=

# --------------------------------------------
# Automation & Workflows
# --------------------------------------------

# N8N (workflow automation)
# From your N8N instance settings
N8N_API_KEY=
N8N_WEBHOOK_URL=

# --------------------------------------------
# Monitoring & Analytics
# --------------------------------------------

# Sentry (error tracking)
SENTRY_DSN=

# --------------------------------------------
# Cloud Providers
# --------------------------------------------

# Railway (deployment)
RAILWAY_TOKEN=

# Vercel (deployment)
VERCEL_TOKEN=

# --------------------------------------------
# AIOS Core Configuration
# --------------------------------------------
NODE_ENV=development
AIOS_VERSION=2.2.0

# Groups fechado por padrão; habilitar explicitamente no runtime de produção.
GROUPS_ENABLED=false

# Company AI Assistant (Studio B2B e Widget de atendimento)
COMPANY_AI_ENABLED=false
NEXT_PUBLIC_COMPANY_AI_STUDIO_ENABLED=false

# --------------------------------------------
# Next.js & Better Auth Security
# --------------------------------------------
# Cryptographically random strings (min 32 chars)
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=

# Cache revalidation between Rails and Next.js. Keep the secret private.
NEXT_REVALIDATE_URL=http://frontend:3000/api/revalidate
NEXT_REVALIDATE_SECRET=

# --------------------------------------------
# Custom Configuration
# --------------------------------------------
# Add your custom API keys below

# ── PostHog (Product Analytics) ──────────────
# Get from: https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
POSTHOG_API_KEY=phxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_WEBHOOK_SECRET=your_webhook_secret_here

# Ranking Performance: mínimo de empresas elegíveis para publicar benchmarks
# (p50, p75 e p90). Ajuste com decisão de Produto/Dados; não altera a fórmula
# nem o ranking orgânico oficial.
RANKING_MIN_COMPARABLE_POPULATION=10

# ── n8n (Growth Orchestration) ───────────────
N8N_WEBHOOK_URL=https://n8n.avaliasolar.com.br/webhook/posthog-event
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret

# n8n Workflow IDs (after importing workflows)
WF_025_ID=
WF_030_ID=
WF_031_ID=

# ── Nutshell CRM ─────────────────────────────
# Get from: Nutshell → Settings → My account → API key
NUTSHELL_API_URL=https://app.nutshell.com/api/v1/json
NUTSHELL_EMAIL=your-email@company.com
NUTSHELL_API_KEY=your_nutshell_api_key

# ── Evolution API (WhatsApp) ─────────────────
EVOLUTION_API_URL=https://evolution.avaliasolar.com.br
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE_NAME=avaliasolar

# ── NewsAPI.org ──────────────────────────────
NEWS_API_KEY=your_newsapi_key

# ── Telegram Bot ─────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-DEFxxxxxxxxxxxx
TELEGRAM_GROWTH_ALERTS_CHAT_ID=-100xxxxxxxxxx

STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_BILLING_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_BILLING_WEBHOOK_URL=https://hooks.slack.com/services/xxxxxxxxx/xxxxxxxxx/xxxxxxxxx

# ── Outbound & Mobilidade Elétrica (Hermes Growth Engine) ──
PROSPEO_API_KEY=your_prospeo_api_key
META_INSTAGRAM_TOKEN=your_meta_instagram_graph_token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxxxxxxx/xxxxxxxxx/xxxxxxxxx
GMAIL_API_KEY=your_gmail_api_key_or_password
SMARTLEAD_API_KEY=your_smartlead_api_key


# SES & SNS Configuration
AWS_REGION=us-east-2
AWS_SES_CONFIGURATION_SET=avalia-solar-crm
AWS_SES_SENDER_IDENTITY=
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-2:431636668039:avalia-solar-ses-events
SALES_EMAIL_SENDING_ENABLED=false
EMAIL_TRACKING_HOST=https://crm.avaliasolar.com.br
TRACK_PROSPECTS_ENABLED=true
PROPOSAL_DOCUMENTS_BUCKET=
PROPOSAL_DOCUMENT_MAX_BYTES=10485760
PROPOSAL_DOCUMENT_SCANNER_COMMAND=clamscan
# MCP Remote / OAuth C2 — Canary publico read-only + Interactive UI R1 habilitados; privado segue false.
MCP_REMOTE_TRANSPORT_ENABLED=true
MCP_REMOTE_PRODUCTION_ENABLED=true
MCP_REMOTE_AUTH_MODE=oauth
MCP_REMOTE_OAUTH_ENABLED=true
MCP_REMOTE_POLICY_ENABLED=true
MCP_PUBLIC_TOOLS_EXECUTION_ENABLED=true
MCP_OAUTH_TOKEN_FORMAT=opaque
MCP_OAUTH_RESOURCE=https://api.avaliasolar.com.br/mcp
MCP_OAUTH_ISSUER=https://api.avaliasolar.com.br
MCP_REMOTE_ALLOWED_HOSTS=api.avaliasolar.com.br
MCP_REMOTE_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com
# Production canary: manter allowlists de client_id e subjects configuradas apenas no servidor/GitHub Vars, nunca versionadas.
MCP_CANARY_ENABLED=true
MCP_CANARY_PHASE=read_only
MCP_CANARY_ALLOWED_CLIENT_IDS=
MCP_CANARY_ALLOWED_SUBJECTS=
MCP_PRIVATE_REMOTE_TRANSPORT_ENABLED=false
MCP_PRIVATE_REMOTE_OAUTH_ENABLED=false
MCP_PRIVATE_REMOTE_POLICY_ENABLED=false
MCP_PRIVATE_OAUTH_RESOURCE=
MCP_PRIVATE_ALLOWED_HOSTS=
MCP_PRIVATE_ALLOWED_ORIGINS=
# MCP Interactive UI (R1): todas as 5 superficies publicas habilitadas.
MCP_UI_ENABLED=true
MCP_UI_SEARCH_ENABLED=true
MCP_UI_PROFILE_ENABLED=true
MCP_UI_REPUTATION_ENABLED=true
MCP_UI_COMPARE_ENABLED=true
MCP_UI_CATEGORIES_ENABLED=true
MCP_UI_RESOURCE_DOMAINS=https://www.avaliasolar.com.br,https://api.avaliasolar.com.br,https://nyc3.digitaloceanspaces.com,https://avalia-solar-assets.nyc3.digitaloceanspaces.com,https://avalia-solar-assets.nyc3.cdn.digitaloceanspaces.com
MCP_UI_ORIGIN=
