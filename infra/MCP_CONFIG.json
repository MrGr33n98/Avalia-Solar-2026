{
  "mcpServers": {
    "posthog": {
      "serverUrl": "https://mcp.posthog.com/sse"
    },
    "n8n-mcp": {
      "serverUrl": "https://n8n.avaliasolar.com.br/mcp-server/http",
      "headers": {
        "Authorization": "${N8N_MCP_AUTHORIZATION}"
      }
    },
    "figma": {
      "serverUrl": "https://mcp.figma.com/mcp"
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "firecrawl": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-firecrawl"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "next-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ]
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "-y",
        "shadcn@latest",
        "mcp"
      ]
    },
    "dbhub": {
      "command": "npx",
      "args": [
        "-y",
        "@bytebase/dbhub@latest",
        "--transport",
        "stdio",
        "--readonly",
        "--dsn",
        "postgresql://postgres:postgres@127.0.0.1:5433/ab0_development"
      ]
    },
    "stitchmcp": {
      "command": "npx",
      "args": [
        "-y",
        "@_davideast/stitch-mcp",
        "serve"
      ]
    },
    "rails-ai-context": {
      "command": "/home/felipe/.gemini/antigravity-ide/scratch/Avalia-Solar-2026/AB0-1-back/bin/rails-ai-context-mcp"
    }
  }
}
