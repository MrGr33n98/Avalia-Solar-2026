      "id": "google-sheets-get-leads",
      "name": "Google Sheets - Get Unscored Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [450, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "2",
          "name": "Google Sheets API"
        }
      }
    },
    {
      "parameters": {
        "language": "python",
        "pythonCode": "# Lead Scoring Algorithm\nitems = _input.all()\nprocessed = []\n\nfor item in items:\n    lead = item[\"json\"]\n    score = 0\n    \n    # Critérios de pontuação\n    if lead.get(\"company_size\", 0) > 50:\n        score += 30\n    \n    if lead.get(\"job_title\") in [\"CEO\", \"CTO\", \"Director\", \"VP\", \"Manager\"]:\n        score += 25\n    \n    if lead.get(\"budget\") == \"high\":\n        score += 20\n    elif lead.get(\"budget\") == \"medium\":\n        score += 10\n    \n    if lead.get(\"urgency\") == \"immediate\":\n        score += 15\n    elif lead.get(\"urgency\") == \"this_month\":\n        score += 10\n    \n    if lead.get(\"engagement_level\", 0) > 7:\n        score += 10\n    elif lead.get(\"engagement_level\", 0) > 4:\n        score += 5\n    \n    # Email corporativo (não gmail, hotmail, etc)\n    email = lead.get(\"email\", \"\")\n    if email and not any(domain in email for domain in [\"gmail\", \"hotmail\", \"yahoo\", \"outlook\"]):\n        score += 10\n    \n    # Tem telefone\n    if lead.get(\"phone\"):\n        score += 5\n    \n    # Classificação\n    if score >= 70:\n        classification = \"🔥 HOT\"\n        priority = \"alta\"\n        action = \"Contatar imediatamente\"\n    elif score >= 40:\n        classification = \"🌡️ WARM\"\n        priority = \"média\"\n        action = \"Contatar em 24h\"\n    else:\n        classification = \"❄️ COLD\"\n        priority = \"baixa\"\n        action = \"Adicionar ao nurturing\"\n    \n    processed.append({\n        \"json\": {\n            **lead,\n            \"score\": score,\n            \"classification\": classification,\n            \"priority\": priority,\n            \"recommended_action\": action,\n            \"scored_at\": _now.isoformat()\n        }\n    })\n\nreturn processed"
      },
      "id": "code-scoring",
      "name": "Code - Lead Scoring Algorithm",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
