{
  "name": "WF-006: Alerta de Deals Parados",
  "nodes": [
    {
      "parameters": {"rule": {"interval": [{"field": "cronExpression", "expression": "0 9 * * 1-5"}]}},
      "id": "schedule",
      "name": "Schedule - Weekdays 9AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Identify Stalled Deals\nconst items = $input.all();\nconst now = new Date();\nconst stalled = [];\n\nfor (const item of items) {\n  const deal = item.json;\n  const lastActivity = new Date(deal.last_activity_date);\n  const daysStalled = Math.floor((now - lastActivity) / (1000 * 60 * 60 * 24));\n  \n  if (daysStalled >= 5 && deal.status === 'open') {\n    const urgency = daysStalled > 10 ? '🚨 CRÍTICO' : daysStalled > 7 ? '⚠️ URGENTE' : '⏰ ATENÇÃO';\n    \n    stalled.push({\n      json: {\n        ...deal,\n        days_stalled: daysStalled,\n        urgency: urgency,\n        recommended_action: daysStalled > 10 ? 'Ligar imediatamente' : 'Enviar email hoje'\n      }\n    });\n  }\n}\n\nreturn stalled;"
      },
      "id": "code-stalled",
      "name": "Code - Identify Stalled Deals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "message",
        "operation": "post",
        "channel": "={{$json.owner_slack_id}}",
        "text": "{{$json.urgency}} Deal Parado",
        "blocksUi": {
          "blocksValues": [{
            "type": "section",
            "textUi": {
              "text": "*{{$json.urgency}}*\\n\\n*Deal:* {{$json.company}}\\n*Valor:* R$ {{$json.value}}\\n*Estágio:* {{$json.stage}}\\n⏱️ *Parado há:* {{$json.days_stalled}} dias\\n*Última atividade:* {{$json.last_activity_date}}\\n\\n*Ação recomendada:* {{$json.recommended_action}}",
              "type": "mrkdwn"
            }
          }]
        }
      },
      "id": "slack-alert",
      "name": "Slack - Alert Owner",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Schedule - Weekdays 9AM": {"main": [[{"node": "Code - Identify Stalled Deals", "type": "main", "index": 0}]]},
    "Code - Identify Stalled Deals": {"main": [[{"node": "Slack - Alert Owner", "type": "main", "index": 0}]]}
  },
  "tags": [{"id": "1", "name": "vendas"}, {"id": "8", "name": "alerts"}]
}
