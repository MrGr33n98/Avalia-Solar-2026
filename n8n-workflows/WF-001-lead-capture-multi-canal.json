{
  "name": "WF-001: Captura de Leads Multi-Canal",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-capture",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook - Lead Capture",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "lead-capture-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Normalizar dados do lead\nconst items = $input.all();\nconst normalized = [];\n\nfor (const item of items) {\n  const lead = item.json.body || item.json;\n  \n  // Extrair dados\n  const normalizedLead = {\n    name: lead.name || lead.full_name || 'Nome não informado',\n    email: lead.email || '',\n    phone: lead.phone || lead.phone_number || '',\n    source: lead.source || lead.utm_source || 'website',\n    product: lead.product || lead.interest || '',\n    company: lead.company || lead.company_name || '',\n    message: lead.message || lead.comments || '',\n    captured_at: new Date().toISOString(),\n    lead_id: `LEAD-${Date.now()}`,\n    status: 'new'\n  };\n  \n  // Enriquecer com informações adicionais\n  normalizedLead.crm_link = `https://crm.example.com/leads/${normalizedLead.lead_id}`;\n  normalizedLead.priority = determinePriority(normalizedLead);\n  \n  normalized.push({\n    json: normalizedLead\n  });\n}\n\nfunction determinePriority(lead) {\n  // Lógica simples de prioridade\n  if (lead.company && lead.email.includes('@gmail.com') === false) {\n    return 'high';\n  }\n  if (lead.phone && lead.message) {\n    return 'medium';\n  }\n  return 'low';\n}\n\nreturn normalized;"
      },
      "id": "code-normalize",
      "name": "Code - Normalize Lead Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "message",
        "operation": "post",
        "channel": "#vendas-leads",
        "text": "🎯 Novo Lead Capturado!",
        "blocksUi": {
          "blocksValues": [
            {
              "type": "section",
              "textUi": {
                "text": "*Nome:* {{$json.name}}\\n*Email:* {{$json.email}}\\n*Telefone:* {{$json.phone}}\\n*Origem:* {{$json.source}}\\n*Interesse:* {{$json.product}}\\n*Empresa:* {{$json.company}}\\n*Prioridade:* {{$json.priority}}",
                "type": "mrkdwn"
              }
            },
            {
              "type": "actions",
              "elementsUi": {
                "elementValues": [
                  {
                    "type": "button",
                    "text": "Qualificar Lead",
                    "url": "={{$json.crm_link}}",
                    "style": "primary"
                  }
                ]
              }
            }
          ]
        }
      },
      "id": "slack-notification",
