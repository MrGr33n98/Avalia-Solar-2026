FROM ruby:3.2.2

# 1. Instalação de dependências do sistema
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      build-essential \
      libpq-dev \
      postgresql-client \
      curl \
      nodejs \
      yarn && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 2. Configuração do diretório de trabalho
WORKDIR /app/AB0-1-back

# 3. Instalação do Bundler
RUN gem install bundler:2.4.22

# 4. Instalação de Gems
COPY AB0-1-back/Gemfile AB0-1-back/Gemfile.lock ./
RUN bundle install --jobs 4 --retry 3

# 5. Cópia do código fonte (excluding secrets)
COPY AB0-1-back/ ./

# 6. Criação de pastas necessárias
RUN mkdir -p tmp/pids tmp/storage public/assets log

# 7. Accept RAILS_MASTER_KEY as build argument
ARG RAILS_MASTER_KEY

# 8. Configuração de Variáveis de Ambiente
ENV RAILS_ENV=production \
    PATH="/app/AB0-1-back/bin:${PATH}"

# 9. Compilação de Assets
# Temporarily write master.key for asset precompilation if provided, then remove it
RUN set -e; \
    if [ -n "$RAILS_MASTER_KEY" ]; then \
      echo "✅ Using provided RAILS_MASTER_KEY for asset compilation"; \
      echo "$RAILS_MASTER_KEY" > config/master.key; \
      bundle exec rake assets:precompile RAILS_ENV=production; \
      rm -f config/master.key; \
    else \
      echo "⚠️  No RAILS_MASTER_KEY provided - using dummy SECRET_KEY_BASE"; \
      SECRET_KEY_BASE=$(openssl rand -hex 64) bundle exec rake assets:precompile RAILS_ENV=production; \
    fi && \
    echo "✅ Asset precompilation complete"

# 10. Exposição da porta
EXPOSE 3001

# 11. Script de Entrada
COPY AB0-1-back/entrypoint.sh /usr/bin/entrypoint.sh
RUN chmod +x /usr/bin/entrypoint.sh

ENTRYPOINT ["/usr/bin/entrypoint.sh"]

# 12. Start
CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0", "-p", "3001"]