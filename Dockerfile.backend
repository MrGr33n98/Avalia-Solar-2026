FROM ruby:3.2.2

# Install system dependencies
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      build-essential \
      libpq-dev \
      postgresql-client \
      curl \
      nodejs \
      yarn && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Install specific bundler version
RUN gem install bundler:2.4.22

# Copy Gemfile and install dependencies
COPY Gemfile Gemfile.lock ./
RUN bundle install --jobs 4 --retry 3

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p tmp/pids tmp/storage public/assets log

# Set environment variables
ENV RAILS_ENV=production \
    PATH="/app/bin:${PATH}" \
    SECRET_KEY_BASE=placeholder_for_asset_compilation

# 👇👇👇 AQUI ESTÁ A CORREÇÃO CRUCIAL 👇👇👇
# 1. ARG: Aceita o argumento que vem do docker-compose
ARG RAILS_MASTER_KEY
# 2. ENV: Torna-o disponível para o comando 'rake assets:precompile' abaixo
ENV RAILS_MASTER_KEY=${RAILS_MASTER_KEY}
# 👆👆👆 FIM DA CORREÇÃO 👆👆👆

# Precompile assets (including ActiveAdmin assets)
RUN bundle exec rake assets:precompile RAILS_ENV=production

EXPOSE 3001

# Start the server
# Add entrypoint script
COPY AB0-1-back/entrypoint.sh /usr/bin/entrypoint.sh
RUN chmod +x /usr/bin/entrypoint.sh

ENTRYPOINT ["/usr/bin/entrypoint.sh"]
CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0", "-p", "3001"]