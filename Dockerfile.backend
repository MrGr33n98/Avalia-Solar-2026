## syntax=docker/dockerfile:1.7
FROM ruby:3.2.2-slim AS builder

# 1. Instalação de dependências do sistema
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      build-essential \
      libpq-dev \
      curl \
      nodejs \
      npm \
      git \
      pkg-config && \
    npm install -g yarn && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 2. Instalação de Gems
COPY AB0-1-back/Gemfile AB0-1-back/Gemfile.lock ./
RUN --mount=type=cache,target=/usr/local/bundle \
    gem install bundler:2.4.22 && \
    bundle config set --local without 'development test' && \
    bundle install --jobs 4 --retry 3 && \
    cp -ar /usr/local/bundle /usr/local/bundle_backup

# Use o backup para o estágio final
RUN rm -rf /usr/local/bundle && mv /usr/local/bundle_backup /usr/local/bundle

# 3. Cópia do código fonte
COPY AB0-1-back/ ./

# 4. Compilação de Assets
ENV RAILS_ENV=production \
    NODE_ENV=production \
    REDIS_ENABLED=false \
    SECRET_KEY_BASE=dummy_value_for_assets_precompile_only

RUN --mount=type=secret,id=rails_master_key \
    set -eux; \
    # Validação rigorosa da Master Key
    if [ ! -f /run/secrets/rails_master_key ] || [ ! -s /run/secrets/rails_master_key ]; then \
      echo "::error::RAILS_MASTER_KEY não encontrada ou vazia! Verifique os secrets do GitHub."; \
      exit 1; \
    fi; \
    cp /run/secrets/rails_master_key config/master.key; \
    chmod 600 config/master.key; \
    \
    # Execução do precompile com stubs para evitar conexões externas
    # DATABASE_URL dummy evita que o Rails tente conectar no Postgres real durante o boot
    # O assets:precompile no Rails 7 (Sprockets/Importmap) carrega o environment.
    DATABASE_URL=postgresql://localhost/dummy \
    bundle exec rake assets:precompile --trace; \
    \
    # Limpeza imediata da master key para não vazar na imagem (mesmo sendo estágio builder)
    rm -f config/master.key

# --- Estágio Final ---
FROM ruby:3.2.2-slim

# Instala apenas dependências de runtime
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      postgresql-client \
      libpq5 \
      curl \
      nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Configuração de ambiente
ENV RAILS_ENV=production \
    RAILS_LOG_TO_STDOUT=true \
    RAILS_SERVE_STATIC_FILES=true \
    PORT=3001

# Copia apenas o necessário do builder para reduzir tamanho da imagem
COPY --from=builder /usr/local/bundle /usr/local/bundle
COPY --from=builder /app/app /app/app
COPY --from=builder /app/bin /app/bin
COPY --from=builder /app/config /app/config
COPY --from=builder /app/db /app/db
COPY --from=builder /app/lib /app/lib
COPY --from=builder /app/public /app/public
COPY --from=builder /app/vendor /app/vendor
COPY --from=builder /app/Gemfile /app/Gemfile
COPY --from=builder /app/Gemfile.lock /app/Gemfile.lock
COPY --from=builder /app/config.ru /app/config.ru
COPY --from=builder /app/Rakefile /app/Rakefile

# Script de entrada
COPY AB0-1-back/entrypoint.sh /usr/bin/entrypoint.sh
RUN chmod +x /usr/bin/entrypoint.sh

EXPOSE 3001

ENTRYPOINT ["/usr/bin/entrypoint.sh"]
CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0", "-p", "3001"]
