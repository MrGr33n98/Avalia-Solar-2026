FROM ruby:3.2.2-slim AS builder

# 1. Instalação de dependências do sistema
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      build-essential \
      libpq-dev \
      curl \
      nodejs \
      npm \
      git \
      pkg-config && \
    npm install -g yarn && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 2. Instalação de Gems
COPY AB0-1-back/Gemfile AB0-1-back/Gemfile.lock ./
RUN gem install bundler:2.4.22 && \
    bundle config set --local without 'development test' && \
    bundle install --jobs 4 --retry 3

# 3. Cópia do código fonte
COPY AB0-1-back/ ./

# 4. Compilação de Assets
ARG RAILS_MASTER_KEY
ENV RAILS_ENV=production
RUN if [ -n "$RAILS_MASTER_KEY" ]; then \
      echo "$RAILS_MASTER_KEY" > config/master.key; \
    fi && \
    SECRET_KEY_BASE=$(openssl rand -hex 64) bundle exec rake assets:precompile && \
    rm -f config/master.key

# --- Estágio Final ---
FROM ruby:3.2.2-slim

# Instala apenas dependências de runtime
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      postgresql-client \
      libpq5 \
      curl \
      nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Configuração de ambiente
ENV RAILS_ENV=production \
    RAILS_LOG_TO_STDOUT=true \
    RAILS_SERVE_STATIC_FILES=true \
    PORT=3001

# Copia artefatos do builder
COPY --from=builder /usr/local/bundle /usr/local/bundle
COPY --from=builder /app /app

# Script de entrada
COPY AB0-1-back/entrypoint.sh /usr/bin/entrypoint.sh
RUN chmod +x /usr/bin/entrypoint.sh

EXPOSE 3001

ENTRYPOINT ["/usr/bin/entrypoint.sh"]
CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0", "-p", "3001"]
