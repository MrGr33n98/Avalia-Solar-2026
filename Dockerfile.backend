FROM ruby:3.2.2

# Install system dependencies
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      build-essential \
      libpq-dev \
      postgresql-client \
      curl \
      nodejs \
      yarn && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Set working directory (O código do Rails vive em AB0-1-back no repositório)
WORKDIR /app/AB0-1-back

# Install specific bundler version
RUN gem install bundler:2.4.22

# Copy Gemfile and install dependencies
# O contexto do build deve ser a raiz do projeto (.)
COPY AB0-1-back/Gemfile AB0-1-back/Gemfile.lock ./
RUN bundle install --jobs 4 --retry 3

# Copy application code
COPY AB0-1-back/ ./

# Create necessary directories
RUN mkdir -p tmp/pids tmp/storage public/assets log

# Set environment variables
ENV RAILS_ENV=production \
    PATH="/app/AB0-1-back/bin:${PATH}"

# --- CORREÇÃO PARA O BUILD NO GITHUB ACTIONS ---
# Usamos SECRET_KEY_BASE_DUMMY para compilar assets sem precisar da Master Key real.
# Isso evita o erro de "uninitialized constant" ou falta de chave durante o build.
RUN SECRET_KEY_BASE_DUMMY=1 bundle exec rake assets:precompile RAILS_ENV=production

EXPOSE 3001

# Add entrypoint script
# O arquivo deve estar em AB0-1-back/entrypoint.sh
COPY AB0-1-back/entrypoint.sh /usr/bin/entrypoint.sh
RUN chmod +x /usr/bin/entrypoint.sh

ENTRYPOINT ["/usr/bin/entrypoint.sh"]
CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0", "-p", "3001"]