FROM ruby:3.2.2

# 1. Instalação de dependências do sistema
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      build-essential \
      libpq-dev \
      postgresql-client \
      curl \
      nodejs \
      yarn && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 2. Configuração do diretório de trabalho
WORKDIR /app/AB0-1-back

# 3. Instalação do Bundler
RUN gem install bundler:2.4.22

# 4. Instalação de Gems
COPY AB0-1-back/Gemfile AB0-1-back/Gemfile.lock ./
RUN bundle install --jobs 4 --retry 3

# 5. Cópia do código fonte
COPY AB0-1-back/ ./

# 6. Criação de pastas necessárias
RUN mkdir -p tmp/pids tmp/storage public/assets log

# 7. Configuração de Variáveis de Ambiente
ENV RAILS_ENV=production \
    PATH="/app/AB0-1-back/bin:${PATH}"

# 8. Compilação de Assets (A CORREÇÃO ESTÁ AQUI)
# SECRET_KEY_BASE_DUMMY=1 engana o Rails para não pedir DB no build
RUN SECRET_KEY_BASE_DUMMY=1 bundle exec rake assets:precompile RAILS_ENV=production

# 9. Exposição da porta
EXPOSE 3001

# 10. Script de Entrada
COPY AB0-1-back/entrypoint.sh /usr/bin/entrypoint.sh
RUN chmod +x /usr/bin/entrypoint.sh

ENTRYPOINT ["/usr/bin/entrypoint.sh"]

# 11. Start
CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0", "-p", "3001"]