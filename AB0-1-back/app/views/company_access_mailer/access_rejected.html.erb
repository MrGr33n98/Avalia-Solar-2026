<% content_for :preheader, "Sua solicitação de acesso à empresa #{@company.name} foi analisada." %>
<p style="margin:0 0 8px;color:#D92D20;font-size:12px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;">Solicitação analisada</p>
<h1 style="margin:0 0 18px;color:#0D1B2A;font-size:26px;">Solicitação rejeitada</h1>
<p style="margin:0 0 14px;">Olá, <strong><%= @user.name.presence || @user.email %></strong>.</p>
<p style="margin:0 0 18px;color:#667085;">Sua solicitação de acesso à empresa <strong><%= @company.name %></strong> não foi aprovada.</p>
<p style="margin:0;padding:14px;border:1px solid #D9E0EA;background:#F7F9FC;"><strong>Motivo:</strong> <%= @reason %></p>
