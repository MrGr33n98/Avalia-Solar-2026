<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title>Avalia Solar | O Ecossistema da Energia Solar</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "globals", "data-turbo-track": "reload" %>
    
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
      :root {
        --font-sans: 'Outfit', sans-serif;
      }
      body {
        font-family: var(--font-sans);
        background-color: #f8fafc;
      }
      .as-nav-glass {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
      }
    </style>
  </head>

  <body class="overflow-x-hidden">
    <!-- Navbar -->
    <nav class="fixed top-0 left-0 right-0 z-50 as-nav-glass">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <!-- Logo -->
          <div class="flex items-center gap-2">
            <div class="h-10 w-10 bg-brand-blue rounded-xl flex items-center justify-center shadow-lg shadow-brand-blue/20">
              <span class="text-white font-bold text-xl">AS</span>
            </div>
            <span class="text-as-slate-900 font-bold text-xl tracking-tight hidden sm:block">Avalia Solar</span>
          </div>

          <!-- Links -->
          <div class="hidden md:flex items-center gap-8">
            <a href="#" class="text-as-slate-800 hover:text-brand-blue font-medium transition-colors">Empresas</a>
            <a href="#" class="text-as-slate-800 hover:text-brand-blue font-medium transition-colors">Produtos</a>
            <a href="#" class="text-as-slate-800 hover:text-brand-blue font-medium transition-colors">Marketplace</a>
            <a href="#" class="text-as-slate-800 hover:text-brand-blue font-medium transition-colors">Sobre</a>
          </div>

          <!-- CTA -->
          <div class="flex items-center gap-4">
            <%= link_to 'Entrar', app_login_path, class: "text-as-slate-800 font-semibold px-4 py-2 hover:bg-slate-100 rounded-lg transition-all" %>
            <a href="#" class="clay-btn-primary px-6 py-2.5 rounded-xl font-bold text-white shadow-lg">Seja Parceiro</a>
          </div>
        </div>
      </div>
    </nav>

    <main class="pt-16">
      <%= yield %>
    </main>

    <!-- Footer Simples -->
    <footer class="bg-as-slate-950 text-white/50 py-12 mt-20">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <div class="flex justify-center gap-4 mb-6">
          <div class="h-8 w-8 bg-white/10 rounded-lg flex items-center justify-center">AS</div>
        </div>
        <p>&copy; 2026 Avalia Solar. Todos os direitos reservados.</p>
        <div class="flex justify-center gap-6 mt-4 text-sm">
          <a href="#" class="hover:text-white">Privacidade</a>
          <a href="#" class="hover:text-white">Termos</a>
          <a href="#" class="hover:text-white">Contato</a>
        </div>
      </div>
    </footer>
  </body>
</html>
