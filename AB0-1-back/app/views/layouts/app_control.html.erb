<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} — Avalia Solar" : "Control Panel — Avalia Solar" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: {
                50: '#eff6ff',
                100: '#dbeafe',
                600: '#2563eb',
                700: '#1d4ed8',
                900: '#0f172a'
              },
              clay: {
                50: '#f8fafc',
                100: '#f1f5f9',
                200: '#e2e8f0'
              }
            },
            boxShadow: {
              panel: '0 18px 48px -24px rgba(15, 23, 42, 0.28)'
            },
            borderRadius: {
              '4xl': '2rem'
            }
          }
        }
      }
    </script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-[radial-gradient(circle_at_top,_#dbeafe_0%,_#f8fafc_42%,_#eef2ff_100%)] text-slate-900 antialiased">
    <div class="flex min-h-screen">
      <%= render 'layouts/app_control/sidebar' %>

      <div class="flex min-h-screen min-w-0 flex-1 flex-col">
        <header class="border-b border-slate-200/80 bg-white/85 px-4 py-4 backdrop-blur md:px-6">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div class="space-y-2">
              <div class="flex items-center gap-2 text-sm text-slate-500">
                <%= link_to app_painel_root_path, class: "inline-flex items-center gap-1 hover:text-slate-900" do %>
                  <span>←</span>
                  <span>Voltar ao painel</span>
                <% end %>
              </div>

              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-slate-100 text-slate-700">
                  <span class="text-sm font-bold">CP</span>
                </div>
                <div>
                  <h1 class="text-xl font-semibold tracking-tight text-slate-950">
                    <%= content_for?(:page_title) ? yield(:page_title) : "Control Panel" %>
                  </h1>
                  <p class="text-sm text-slate-500">
                    Configuração global da operação para <%= @current_app_company&.name || current_user&.name %>.
                  </p>
                </div>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">
                <%= current_control_role.to_s.humanize.presence || "Sem papel" %>
              </span>
              <%= link_to "Trocar empresa", app_root_path, class: "inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
            </div>
          </div>
        </header>

        <% if notice.present? %>
          <div class="mx-4 mt-4 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 md:mx-6">
            <%= notice %>
          </div>
        <% end %>

        <% if alert.present? %>
          <div class="mx-4 mt-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 md:mx-6">
            <%= alert %>
          </div>
        <% end %>

        <main class="flex-1 px-4 py-6 md:px-6 xl:px-8">
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
