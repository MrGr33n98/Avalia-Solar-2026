<%# Partial: layouts/app/_nav_item.html.erb
    locals: icon (string), label (string), path (string), active (boolean) %>
<% active ||= false %>

<%= link_to path,
      class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors #{active ? 'bg-white/10 text-white font-medium' : 'text-white/60 hover:bg-white/5 hover:text-white'}" do %>
  <%= render "layouts/app/icon_#{icon}" rescue nil %>
  <span><%= label %></span>
<% end %>
