<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for?(:title) ? yield(:title) + " — Avalia Solar" : "Avalia Solar App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              solar: { 400: '#facc15', 500: '#eab308' }
            }
          }
        }
      }
    </script>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-gray-50 flex flex-col items-center justify-center px-4">

    <%# Flash %>
    <% if notice.present? %>
      <div class="w-full max-w-sm mb-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
        <%= notice %>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="w-full max-w-sm mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
        <%= alert %>
      </div>
    <% end %>

    <%= yield %>

    <%# Footer %>
    <p class="mt-8 text-xs text-gray-400">
      &copy; <%= Date.current.year %> Avalia Solar. Todos os direitos reservados.
    </p>

  </body>
</html>
