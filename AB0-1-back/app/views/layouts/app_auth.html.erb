<!DOCTYPE html>
<html lang="pt-BR" class="h-full">
  <head>
    <title><%= content_for?(:title) ? yield(:title) + " — Avalia Solar" : "Avalia Solar" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              solar: { 400: '#facc15', 500: '#eab308', 600: '#ca8a04' }
            }
          }
        }
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    </style>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" rescue nil %>
    <%= javascript_importmap_tags rescue nil %>
  </head>

  <body class="min-h-full bg-slate-50 flex flex-col items-center justify-center p-4 sm:p-6 lg:p-8 antialiased text-slate-900">

    <%# Flash Notices %>
    <% if notice.present? %>
      <div class="w-full max-w-[960px] mb-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 shadow-xs">
        <%= notice %>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="w-full max-w-[960px] mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 shadow-xs">
        <%= alert %>
      </div>
    <% end %>

    <%= yield %>

    <%# Footer %>
    <p class="mt-8 text-xs text-slate-400">
      &copy; <%= Date.current.year %> Avalia Solar. Todos os direitos reservados.
    </p>

  </body>
</html>
