<% content_for :page_title, "Expo — Ecossistema Solar" %>

<%# Hero %>
<div class="bg-[#0a1628] text-white py-16 px-6 text-center rounded-2xl mb-10">
  <h1 class="text-3xl md:text-4xl font-bold mb-3">
    O Ecossistema Solar do Brasil
  </h1>
  <p class="text-white/60 text-lg mb-6">
    Onde os melhores fornecedores encontram os melhores integradores.
  </p>
  <div class="flex justify-center gap-3">
    <%= link_to 'Encontrar Fornecedores', app_suppliers_path,
          class: 'px-5 py-2.5 bg-yellow-400 text-[#0a1628] font-semibold rounded-lg hover:bg-yellow-300 transition-colors' %>
    <%= link_to 'Sou Empresa', app_login_path,
          class: 'px-5 py-2.5 border border-white/30 text-white rounded-lg hover:border-white/60 transition-colors' %>
  </div>
</div>

<%# Fornecedores em destaque %>
<% if @suppliers.any? %>
  <section class="mb-10">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-gray-900">Fornecedores em Destaque</h2>
      <%= link_to 'Ver todos', app_suppliers_path,
            class: 'text-sm text-blue-600 hover:text-blue-800' %>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @suppliers.each do |company| %>
        <%= render 'app/expo/company_card', company: company %>
      <% end %>
    </div>
  </section>
<% end %>

<%# Integradores %>
<% if @integrators.any? %>
  <section class="mb-10">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-gray-900">Integradores / EPC</h2>
      <%= link_to 'Ver todos', app_integrators_path,
            class: 'text-sm text-blue-600 hover:text-blue-800' %>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @integrators.each do |company| %>
        <%= render 'app/expo/company_card', company: company %>
      <% end %>
    </div>
  </section>
<% end %>
