<%# locals: company %>
<div class="bg-white rounded-xl border border-gray-200 p-5 hover:shadow-md transition-shadow">
  <div class="flex items-start justify-between mb-3">
    <div class="flex items-center gap-3">
      <% if company.logo.attached? %>
        <%= image_tag company.logo, class: "w-10 h-10 rounded-lg object-contain bg-gray-50" %>
      <% else %>
        <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center text-xs font-bold text-gray-500">
          <%= company.name.first(2).upcase %>
        </div>
      <% end %>
      <div>
        <h3 class="text-sm font-semibold text-gray-900"><%= company.name %></h3>
        <p class="text-xs text-gray-400"><%= company.city %><%= ", #{company.state}" if company.state %></p>
      </div>
    </div>
    <% if company.featured? %>
      <span class="text-xs px-2 py-0.5 bg-yellow-100 text-yellow-700 rounded-full font-medium">Premium</span>
    <% end %>
  </div>

  <p class="text-xs text-gray-500 line-clamp-2 mb-3"><%= company.description %></p>

  <div class="flex items-center justify-between">
    <div class="flex items-center gap-1 text-xs text-gray-500">
      <span>⭐</span>
      <span class="font-medium"><%= company.rating_avg %></span>
      <span class="text-gray-300">(</span>
      <span><%= company.rating_count %></span>
      <span class="text-gray-300">)</span>
    </div>
    <span class="text-xs px-2 py-0.5 bg-gray-100 text-gray-500 rounded-full capitalize">
      <%= company.segment %>
    </span>
  </div>
</div>
