<section class="space-y-6">
  <div class="rounded-4xl border border-slate-200 bg-white p-6 shadow-panel md:p-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="space-y-3">
        <span class="inline-flex rounded-full bg-slate-900 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-white">
          <%= eyebrow %>
        </span>
        <div class="space-y-2">
          <h2 class="text-2xl font-semibold tracking-tight text-slate-950"><%= title %></h2>
          <p class="max-w-3xl text-sm leading-6 text-slate-600"><%= description %></p>
        </div>
      </div>

      <div class="inline-flex items-center gap-2 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-medium text-amber-900">
        <span>Fundação Rails + Hotwire pronta</span>
      </div>
    </div>
  </div>

  <div class="grid gap-4 xl:grid-cols-[1.4fr,0.8fr]">
    <div class="rounded-4xl border border-slate-200 bg-white p-6 shadow-panel">
      <h3 class="text-base font-semibold text-slate-900">Próximos blocos sugeridos</h3>
      <div class="mt-4 space-y-3">
        <% bullets.each do |bullet| %>
          <div class="flex items-start gap-3 rounded-2xl border border-slate-100 bg-slate-50/80 px-4 py-3">
            <div class="mt-1 h-2.5 w-2.5 rounded-full bg-blue-600"></div>
            <p class="text-sm leading-6 text-slate-700"><%= bullet %></p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="rounded-4xl border border-slate-200 bg-white p-6 shadow-panel">
      <h3 class="text-base font-semibold text-slate-900">Estado desta entrega</h3>
      <div class="mt-4 space-y-4 text-sm leading-6 text-slate-600">
        <p>O namespace <code>/control</code> já existe no subdomínio <code>app</code>, com autorização por membership.</p>
        <p>O próximo passo natural é trocar este placeholder pela primeira tela funcional do bloco.</p>
      </div>
    </div>
  </div>
</section>
