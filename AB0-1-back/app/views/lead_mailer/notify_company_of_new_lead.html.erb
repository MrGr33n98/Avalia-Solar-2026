<% content_for :preheader, "Novo lead qualificado aguardando atendimento" %>
<h1 style="margin:0 0 16px;font-size:24px;line-height:1.2;color:#172033;">Novo lead qualificado</h1>
<p style="margin:0 0 20px;color:#667085;line-height:1.6;">
  Um consumidor demonstrou interesse e foi direcionado para <strong><%= @company.name %></strong>.
</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #D9E0EA;border-collapse:collapse;margin-bottom:20px;">
  <tr><td style="padding:10px 12px;border-bottom:1px solid #D9E0EA;">Nome</td><td style="padding:10px 12px;border-bottom:1px solid #D9E0EA;"><strong><%= @lead.name.presence || 'Não informado' %></strong></td></tr>
  <tr><td style="padding:10px 12px;border-bottom:1px solid #D9E0EA;">Cidade</td><td style="padding:10px 12px;border-bottom:1px solid #D9E0EA;"><%= [@lead.city, @lead.state].compact.join('/') %></td></tr>
  <tr><td style="padding:10px 12px;border-bottom:1px solid #D9E0EA;">Intent Score</td><td style="padding:10px 12px;border-bottom:1px solid #D9E0EA;"><strong><%= @lead.lead_score %>/100</strong></td></tr>
  <tr><td style="padding:10px 12px;">Fatura mensal</td><td style="padding:10px 12px;"><%= @lead.monthly_bill.present? ? number_to_currency(@lead.monthly_bill, unit: 'R$ ', separator: ',', delimiter: '.') : 'Não informada' %></td></tr>
</table>
<table role="presentation" cellpadding="0" cellspacing="0"><tr>
  <td style="padding-right:10px;"><a href="<%= @inbox_url %>" style="display:inline-block;background:#0A66C2;color:#fff;text-decoration:none;padding:13px 18px;border-radius:2px;font-weight:bold;">Abrir Live Inbox</a></td>
  <% if @whatsapp_url.present? %>
    <td><a href="<%= @whatsapp_url %>" style="display:inline-block;background:#0D1B2A;color:#fff;text-decoration:none;padding:13px 18px;border-radius:2px;font-weight:bold;">Abrir WhatsApp</a></td>
  <% end %>
</tr></table>
