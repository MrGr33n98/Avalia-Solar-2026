<% content_for :preheader, "Você foi convidado para gerenciar a #{@company.name} no Avalia Solar." %>
<p style="margin:0 0 8px;color:#0A66C2;font-size:12px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;">Convite de equipe</p>
<h1 style="margin:0 0 18px;color:#0D1B2A;font-size:26px;">Participe da equipe</h1>
<p style="margin:0 0 14px;">Olá,</p>
<p style="margin:0 0 14px;color:#334155;"><strong><%= @invited_by.name.presence || @invited_by.email %></strong> convidou você para colaborar na gestão da empresa <strong><%= @company.name %></strong> com o perfil <strong><%= @invitation.role %></strong>.</p>
<p style="margin:0 0 22px;color:#64748B;font-size:14px;">Este convite expira em 7 dias.</p>
<table role="presentation" cellspacing="0" cellpadding="0" border="0">
  <tr>
    <td bgcolor="#0A66C2" style="border-radius:8px;">
      <a href="<%= @accept_url %>" style="display:inline-block;padding:13px 24px;color:#FFFFFF;text-decoration:none;font-weight:bold;border-radius:8px;">Aceitar convite</a>
    </td>
  </tr>
</table>
