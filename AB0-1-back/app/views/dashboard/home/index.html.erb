<div class="mb-8">
  <h1 class="text-2xl font-semibold">Resumo do Dashboard</h1>
  <p class="text-slate-600">Visao rapida da performance da sua empresa.</p>
</div>

<div class="grid gap-6 md:grid-cols-3">
  <div class="rounded-xl bg-white shadow-sm p-6">
    <div class="text-sm text-slate-500">Total de Leads</div>
    <div class="mt-2 text-3xl font-semibold"><%= @total_leads %></div>
  </div>
  <div class="rounded-xl bg-white shadow-sm p-6">
    <div class="text-sm text-slate-500">Visualizacoes Totais</div>
    <div class="mt-2 text-3xl font-semibold"><%= @total_views %></div>
  </div>
  <div class="rounded-xl bg-white shadow-sm p-6">
    <div class="text-sm text-slate-500">Media de Avaliacoes</div>
    <div class="mt-2 text-3xl font-semibold"><%= number_with_precision(@average_rating, precision: 2) %></div>
  </div>
</div>
