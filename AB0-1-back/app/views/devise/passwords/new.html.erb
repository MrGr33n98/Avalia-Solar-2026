<% content_for :title, "Recuperar Senha" %>

<div class="w-full max-w-[440px] mx-auto my-auto">
  <!-- Astryx Style Card -->
  <div class="w-full bg-white rounded-2xl shadow-sm border border-slate-200/80 p-6 sm:p-8">
    <!-- Brand Logo Header with Official Avalia Solar Logo -->
    <div class="flex items-center justify-center gap-2 mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1500 345" class="h-8 w-auto" role="img" aria-label="Avalia Solar">
        <defs>
          <linearGradient id="solarA_pwd" x1="20" y1="45" x2="275" y2="230" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#FFE08A"/>
            <stop offset="0.52" stop-color="#F6B91A"/>
            <stop offset="1" stop-color="#F59E0B"/>
          </linearGradient>
          <linearGradient id="blueA_pwd" x1="145" y1="115" x2="275" y2="332" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#2563EB"/>
            <stop offset="1" stop-color="#081326"/>
          </linearGradient>
        </defs>
        <g transform="translate(18 6)">
          <path d="M15 128 L313 5 L225 334 L174 181 Z" fill="url(#solarA_pwd)"/>
          <path d="M15 128 L174 181 L141 126 Z" fill="#F59E0B"/>
          <path d="M174 181 L225 334 L226 123 Z" fill="url(#blueA_pwd)"/>
          <path d="M141 126 L226 123 L174 181 Z" fill="#155EEF"/>
          <path d="M174 181 L226 123 L210 177 L225 334 Z" fill="#0B2A4A" opacity="0.92"/>
          <path d="M226 123 L313 5 L174 181 Z" fill="#F6B91A" opacity="0.72"/>
        </g>
        <g fill="#081326">
          <text x="390" y="215" font-family="Inter, Manrope, Avenir Next, Helvetica Neue, Arial, sans-serif" font-size="138" font-weight="720" letter-spacing="-5">Avalia Solar</text>
        </g>
      </svg>
    </div>

    <div class="text-center mb-6">
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Recuperar senha</h1>
      <p class="text-sm text-slate-500 mt-1.5">Insira seu e-mail para receber as instruções</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4", data: { turbo: false } }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <label for="user_email" class="block text-xs font-semibold text-slate-700 mb-1.5">E-mail cadastrado</label>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "nome@empresa.com.br",
            class: "w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 text-sm transition-colors shadow-2xs" %>
      </div>

      <div class="pt-2">
        <%= f.submit "Enviar instruções",
            class: "w-full py-2.5 px-4 rounded-lg bg-amber-500 hover:bg-amber-600 active:bg-amber-700 text-white font-semibold text-sm shadow-xs transition-colors cursor-pointer text-center flex items-center justify-center" %>
      </div>
    <% end %>

    <div class="mt-6 text-center text-xs text-slate-500">
      Lembrou sua senha?
      <%= link_to "Voltar ao login", new_session_path(resource_name), class: "font-semibold text-amber-600 hover:text-amber-700 transition-colors ml-1" %>
    </div>
  </div>
</div>
