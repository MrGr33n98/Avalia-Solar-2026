<% content_for :title, "Entrar" %>

<div class="w-full max-w-[960px] mx-auto my-auto">
  <!-- Astryx Style Two-Column Split Card -->
  <div class="w-full bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden grid grid-cols-1 md:grid-cols-12">
    
    <!-- Left Column: Form Section -->
    <div class="md:col-span-7 p-6 sm:p-8 lg:p-10 flex flex-col justify-between">
      <div>
        <!-- Brand Logo Header with Official Avalia Solar Logo -->
        <div class="flex items-center gap-2 mb-8">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1500 345" class="h-8 w-auto" role="img" aria-label="Avalia Solar">
            <defs>
              <linearGradient id="solarA_login" x1="20" y1="45" x2="275" y2="230" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#FFE08A"/>
                <stop offset="0.52" stop-color="#F6B91A"/>
                <stop offset="1" stop-color="#F59E0B"/>
              </linearGradient>
              <linearGradient id="blueA_login" x1="145" y1="115" x2="275" y2="332" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#2563EB"/>
                <stop offset="1" stop-color="#081326"/>
              </linearGradient>
            </defs>
            <g transform="translate(18 6)">
              <path d="M15 128 L313 5 L225 334 L174 181 Z" fill="url(#solarA_login)"/>
              <path d="M15 128 L174 181 L141 126 Z" fill="#F59E0B"/>
              <path d="M174 181 L225 334 L226 123 Z" fill="url(#blueA_login)"/>
              <path d="M141 126 L226 123 L174 181 Z" fill="#155EEF"/>
              <path d="M174 181 L226 123 L210 177 L225 334 Z" fill="#0B2A4A" opacity="0.92"/>
              <path d="M226 123 L313 5 L174 181 Z" fill="#F6B91A" opacity="0.72"/>
            </g>
            <g fill="#081326">
              <text x="390" y="215" font-family="Inter, Manrope, Avenir Next, Helvetica Neue, Arial, sans-serif" font-size="138" font-weight="720" letter-spacing="-5">Avalia Solar</text>
            </g>
          </svg>
        </div>

        <!-- Form Heading -->
        <div class="mb-6">
          <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">Bem-vindo de volta</h1>
          <p class="text-sm text-slate-500 mt-1.5">Acesse sua conta para continuar no Avalia Solar</p>
        </div>

        <!-- Login Form -->
        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4", data: { turbo: false } }) do |f| %>
          <div>
            <label for="user_email" class="block text-xs font-semibold text-slate-700 mb-1.5">E-mail corporativo ou pessoal</label>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "nome@empresa.com.br",
                class: "w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 text-sm transition-colors shadow-2xs" %>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="user_password" class="block text-xs font-semibold text-slate-700">Senha</label>
              <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
                <%= link_to "Esqueceu a senha?", new_password_path(resource_name), class: "text-xs text-amber-600 hover:text-amber-700 font-medium transition-colors" %>
              <% end %>
            </div>
            <%= f.password_field :password, autocomplete: "current-password", placeholder: "Digite sua senha",
                class: "w-full px-3.5 py-2.5 rounded-lg border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 text-sm transition-colors shadow-2xs" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="flex items-center justify-between pt-0.5">
              <label class="flex items-center gap-2 cursor-pointer text-xs text-slate-600 select-none">
                <%= f.check_box :remember_me, class: "rounded border-slate-300 text-amber-500 focus:ring-amber-400 w-4 h-4 cursor-pointer" %>
                <span>Lembrar de mim</span>
              </label>
            </div>
          <% end %>

          <div class="pt-2">
            <%= f.submit "Entrar",
                class: "w-full py-2.5 px-4 rounded-lg bg-amber-500 hover:bg-amber-600 active:bg-amber-700 text-white font-semibold text-sm shadow-xs transition-colors cursor-pointer text-center flex items-center justify-center" %>
          </div>
        <% end %>

        <!-- Divider -->
        <div class="relative my-6">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-slate-200/80"></div>
          </div>
          <div class="relative flex justify-center text-xs uppercase">
            <span class="bg-white px-3 text-slate-400 font-medium tracking-wider">Ou continue com</span>
          </div>
        </div>

        <!-- Social Sign-in -->
        <div class="space-y-3">
          <%- if devise_mapping.omniauthable? && resource_class.omniauth_providers.include?(:google_oauth2) %>
            <%= button_to user_google_oauth2_omniauth_authorize_path, method: :post, data: { turbo: false },
                class: "w-full py-2.5 px-4 rounded-lg border border-slate-200 hover:bg-slate-50 active:bg-slate-100 text-slate-700 font-medium text-sm flex items-center justify-center gap-2.5 transition-colors shadow-2xs cursor-pointer" do %>
              <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
              </svg>
              <span>Entrar com Google</span>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Sign up link -->
      <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
        <div class="mt-8 pt-4 border-t border-slate-100 text-center text-xs text-slate-500">
          Não tem uma conta?
          <%= link_to "Cadastre-se", new_registration_path(resource_name), class: "font-semibold text-amber-600 hover:text-amber-700 transition-colors ml-1" %>
        </div>
      <% end %>
    </div>

    <!-- Right Column: Visual Cover Section -->
    <div class="hidden md:flex md:col-span-5 relative bg-slate-900 text-white p-8 lg:p-10 flex-col justify-between overflow-hidden">
      <!-- Background Image with Overlay -->
      <img src="/images/solar-cover.webp" alt="Instalação Solar" class="absolute inset-0 w-full h-full object-cover opacity-35" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/70 to-slate-900/40"></div>

      <!-- Top Badge -->
      <div class="relative z-10">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-xs font-medium text-amber-300">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
          MCP Server &bull; OAuth 2.0
        </span>
      </div>

      <!-- Bottom Authority / Copy -->
      <div class="relative z-10 space-y-3">
        <h2 class="text-xl font-bold tracking-tight text-white leading-snug">
          Inteligência e Auditoria do Setor Solar
        </h2>
        <p class="text-xs text-slate-300 leading-relaxed font-normal">
          Conecte ferramentas inteligentes, agentes de IA e clientes MCP à maior rede de dados auditados de energia solar no Brasil.
        </p>

        <div class="pt-2 flex items-center gap-4 text-[11px] text-slate-400 font-medium">
          <span class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Dados Auditados
          </span>
          <span class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            OAuth Seguro
          </span>
        </div>
      </div>
    </div>

  </div>

  <!-- Footer Terms & Privacy -->
  <p class="mt-6 text-center text-xs text-slate-400 max-w-[420px] mx-auto leading-relaxed">
    Ao continuar, você concorda com nossos
    <a href="https://www.avaliasolar.com.br/termos" target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-600 transition-colors">Termos de Serviço</a> e
    <a href="https://www.avaliasolar.com.br/privacidade" target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-600 transition-colors">Política de Privacidade</a>.
  </p>
</div>
