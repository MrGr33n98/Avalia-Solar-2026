<% content_for :title, "Entrar" %>

<div class="w-full max-w-[400px] flex flex-col items-center">
  <!-- Brand Logo & Header -->
  <div class="flex flex-col items-center mb-6">
    <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-white shadow-md shadow-amber-500/20 mb-2.5">
      <!-- Solar Sun Icon -->
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
      </svg>
    </div>
    <span class="text-lg font-bold text-slate-900 tracking-tight">Avalia Solar</span>
  </div>

  <!-- Astryx Style Card -->
  <div class="w-full bg-white rounded-2xl shadow-sm border border-slate-200/80 p-8">
    <!-- Card Header -->
    <div class="text-center mb-6">
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Bem-vindo de volta</h1>
      <p class="text-sm text-slate-500 mt-1">Acesse sua conta para continuar</p>
    </div>

    <!-- Login Form -->
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4", data: { turbo: false } }) do |f| %>
      <div>
        <label for="user_email" class="block text-xs font-medium text-slate-700 mb-1.5">E-mail</label>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "nome@empresa.com.br",
            class: "w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 text-sm transition-all shadow-2xs" %>
      </div>

      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="user_password" class="block text-xs font-medium text-slate-700">Senha</label>
          <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
            <%= link_to "Esqueceu a senha?", new_password_path(resource_name), class: "text-xs text-amber-600 hover:text-amber-700 font-medium transition-colors" %>
          <% end %>
        </div>
        <%= f.password_field :password, autocomplete: "current-password", placeholder: "Digite sua senha",
            class: "w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 text-sm transition-all shadow-2xs" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center justify-between pt-1">
          <label class="flex items-center gap-2 cursor-pointer text-xs text-slate-600 select-none">
            <%= f.check_box :remember_me, class: "rounded border-slate-300 text-amber-500 focus:ring-amber-400 w-4 h-4 cursor-pointer" %>
            <span>Lembrar de mim</span>
          </label>
        </div>
      <% end %>

      <div class="pt-2">
        <%= f.submit "Entrar",
            class: "w-full py-3 px-4 rounded-xl bg-amber-500 hover:bg-amber-600 active:bg-amber-700 text-white font-semibold text-sm shadow-sm transition-all duration-150 cursor-pointer text-center flex items-center justify-center" %>
      </div>
    <% end %>

    <!-- Divider -->
    <div class="relative my-6">
      <div class="absolute inset-0 flex items-center">
        <div class="w-full border-t border-slate-200/70"></div>
      </div>
      <div class="relative flex justify-center text-xs uppercase">
        <span class="bg-white px-3 text-slate-400 font-medium">Ou continue com</span>
      </div>
    </div>

    <!-- Social Sign-in -->
    <div class="space-y-3">
      <%- if devise_mapping.omniauthable? && resource_class.omniauth_providers.include?(:google_oauth2) %>
        <%= button_to user_google_oauth2_omniauth_authorize_path, method: :post, data: { turbo: false },
            class: "w-full py-2.5 px-4 rounded-xl border border-slate-200 hover:bg-slate-50 active:bg-slate-100 text-slate-700 font-medium text-sm flex items-center justify-center gap-2.5 transition-all shadow-2xs cursor-pointer" do %>
          <!-- Google 4-Color SVG -->
          <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          <span>Entrar com Google</span>
        <% end %>
      <% end %>
    </div>

    <!-- Sign up Link -->
    <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
      <div class="mt-6 text-center text-xs text-slate-500">
        Não tem uma conta?
        <%= link_to "Cadastre-se", new_registration_path(resource_name), class: "font-semibold text-amber-600 hover:text-amber-700 transition-colors ml-1" %>
      </div>
    <% end %>
  </div>

  <!-- Terms & Privacy Footer -->
  <p class="mt-6 text-center text-xs text-slate-400 max-w-[340px] leading-relaxed">
    Ao continuar, você concorda com nossos
    <a href="https://www.avaliasolar.com.br/termos" target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-600 transition-colors">Termos de Serviço</a> e
    <a href="https://www.avaliasolar.com.br/privacidade" target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-600 transition-colors">Política de Privacidade</a>.
  </p>
</div>
