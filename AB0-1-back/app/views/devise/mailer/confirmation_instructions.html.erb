<% logo_url = "https://avaliasolar.com.br/images/logo.png" %>
<% avatar_url = "https://media.licdn.com/dms/image/v2/D4D03AQFo5HuelMtsgA/profile-displayphoto-scale_200_200/B4DZwC2IkNG4AY-/0/1769574271819?e=1771459200&v=beta&t=TGfON4BVrQVGMoiaSIQES8u0s4LCUa9LJ7EqDDtjYMg" %>
<% frontend_origin = ENV.fetch('FRONTEND_ORIGIN', 'https://avaliasolar.com.br').to_s.chomp('/') %>
<% confirm_url = "#{frontend_origin}/register?confirmation_token=#{ERB::Util.url_encode(@token)}" %>

<div style="font-family: Arial, sans-serif; max-width: 560px; margin: 0 auto; color: #1f2937;">
  <div style="text-align: center; padding: 16px 0;">
    <img src="<%= logo_url %>" alt="Avalia Solar" style="height: 48px;">
  </div>

  <h1 style="margin: 0 0 8px; font-size: 22px;">Confirme seu e-mail</h1>
  <p style="margin: 0 0 16px;">Olá <strong><%= @email %></strong>,</p>

  <p style="margin: 0 0 16px;">
    Falta só um passo para ativar sua conta e começar a receber avaliações e novos clientes.
    Confirme seu e-mail para liberar o acesso.
  </p>

  <div style="display: flex; align-items: center; gap: 12px; margin: 16px 0;">
    <img src="<%= avatar_url %>" alt="Felipe — CEO" style="width: 56px; height: 56px; border-radius: 50%; object-fit: cover;">
    <div>
      <div style="font-weight: 600;">Felipe — CEO Avalia Solar</div>
      <div style="color: #6b7280; font-size: 14px;">Estamos prontos para ajudar sua empresa a crescer.</div>
    </div>
  </div>

  <p style="text-align: center; margin: 0 0 24px;">
    <a href="<%= confirm_url %>" style="background:#16a34a;color:#fff;text-decoration:none;padding:12px 20px;border-radius:8px;display:inline-block;">
      Confirmar meu e-mail
    </a>
  </p>

  <p style="color:#6b7280;font-size:12px;margin:0;">Se você não solicitou, pode ignorar esta mensagem.</p>
</div>
