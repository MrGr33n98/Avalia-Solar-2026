<% frontend_origin = ENV.fetch('FRONTEND_ORIGIN', 'https://avaliasolar.com.br').to_s.chomp('/') %>
<% confirm_url = "#{frontend_origin}/confirm-email/#{ERB::Util.url_encode(@token)}" %>

<p>Ola <%= @email %>!</p>

<p>Voce pode confirmar seu e-mail clicando no link abaixo:</p>

<p><%= link_to 'Confirmar meu e-mail', confirm_url %></p>
