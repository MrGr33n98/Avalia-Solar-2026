<% content_for :preheader, 'Use este link seguro para redefinir sua senha.' %>
<p style="margin:0 0 8px;color:#0A66C2;font-size:12px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;">Segurança da conta</p>
<h1 style="margin:0 0 18px;color:#0D1B2A;font-size:26px;line-height:1.2;">Redefinição de senha</h1>
<p style="margin:0 0 14px;">Olá, <strong><%= @user.name.presence || @user.email %></strong>.</p>
<p style="margin:0 0 22px;color:#667085;">Recebemos uma solicitação para redefinir a senha da sua conta.</p>
<table role="presentation" cellspacing="0" cellpadding="0" border="0"><tr><td bgcolor="#0A66C2" style="border:1px solid #0A66C2;"><a href="<%= @reset_password_url %>" style="display:inline-block;padding:13px 22px;color:#FFFFFF;text-decoration:none;font-weight:bold;">Redefinir minha senha</a></td></tr></table>
<p style="margin:22px 0 0;padding-top:18px;border-top:1px solid #D9E0EA;color:#667085;font-size:13px;">Se você não solicitou a alteração, ignore este e-mail.</p>
