<% logo_url = "https://avaliasolar.com.br/images/logo.png" %>
<% avatar_url = "https://media.licdn.com/dms/image/v2/D4D03AQFo5HuelMtsgA/profile-displayphoto-scale_200_200/B4DZwC2IkNG4AY-/0/1769574271819?e=1771459200&v=beta&t=TGfON4BVrQVGMoiaSIQES8u0s4LCUa9LJ7EqDDtjYMg" %>
<% frontend_login_url = ENV.fetch('FRONTEND_LOGIN_URL', 'https://www.avaliasolar.com.br/login') %>

<div style="font-family: Arial, sans-serif; max-width: 560px; margin: 0 auto; color: #1f2937;">
  <div style="text-align: center; padding: 16px 0;">
    <img src="<%= logo_url %>" alt="Avalia Solar" style="height: 48px;">
  </div>

  <h1 style="margin: 0 0 8px; font-size: 22px;">Sua conta foi aprovada!</h1>
  <p style="margin: 0 0 16px;">Olá <strong><%= @user.name %></strong>,</p>

  <p style="margin: 0 0 16px;">
    Boas-vindas à Avalia Solar! Sua conta foi aprovada e você já pode acessar a plataforma.
    Aqui você ganha visibilidade, reputação e novos clientes com avaliações reais.
  </p>

  <div style="display: flex; align-items: center; gap: 12px; margin: 16px 0;">
    <img src="<%= avatar_url %>" alt="Felipe — CEO" style="width: 56px; height: 56px; border-radius: 50%; object-fit: cover;">
    <div>
      <div style="font-weight: 600;">Felipe — CEO Avalia Solar</div>
      <div style="color: #6b7280; font-size: 14px;">Conta com avaliação e presença digital em um só lugar.</div>
    </div>
  </div>

  <p style="margin: 0 0 16px;">Clique abaixo para entrar agora:</p>
  <p style="text-align: center; margin: 0 0 24px;">
    <a href="<%= frontend_login_url %>" style="background:#16a34a;color:#fff;text-decoration:none;padding:12px 20px;border-radius:8px;display:inline-block;">
      Entrar na Avalia Solar
    </a>
  </p>

  <p style="color:#6b7280;font-size:12px;margin:0;">Se tiver qualquer dúvida, é só responder este e-mail.</p>
</div>
