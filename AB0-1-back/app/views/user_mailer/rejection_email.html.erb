<% content_for :preheader, 'Há uma atualização importante sobre sua conta.' %>
<p style="margin:0 0 8px;color:#D92D20;font-size:12px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;">Atualização da conta</p>
<h1 style="margin:0 0 18px;color:#0D1B2A;font-size:26px;line-height:1.2;">Não foi possível aprovar sua conta</h1>
<p style="margin:0 0 14px;">Olá, <strong><%= @user.name.presence || @user.email %></strong>.</p>
<p style="margin:0;color:#667085;">Nossa equipe não conseguiu aprovar o cadastro neste momento. Entre em contato com o suporte para revisar as informações.</p>
