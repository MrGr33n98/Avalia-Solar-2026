<p style="margin:0 0 8px;color:#D92D20;font-size:12px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;">Alerta administrativo</p>
<h1 style="margin:0 0 18px;color:#0D1B2A;font-size:26px;"><%= @alert_type %></h1>
<div style="padding:16px;border:1px solid #D9E0EA;background:#F7F9FC;"><%= @details %></div>
<p style="margin:18px 0 0;color:#667085;font-size:13px;">Registrado em <%= l(@timestamp, format: :long) %>.</p>
