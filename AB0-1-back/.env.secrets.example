DATABASE_URL=postgres://user:pass@host:5432/dbname
RAILS_MASTER_KEY=your_master_key
POSTGRES_HOST=host
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=dbname
HOST=your_host
USERNAME=your_username
KEY=your_ssh_key
JWT_SECRET=your_jwt_secret

# Rate Limiting - Rack::Attack (TASK-001)
# Comma-separated list of IPs to block
BLOCKED_IPS=

# TASK-014: Redis Configuration
REDIS_URL=redis://localhost:6379/0
# For production with password:
# REDIS_URL=redis://:password@hostname:6379/0
# For Redis Cloud:
# REDIS_URL=rediss://username:password@hostname:port

# TASK-006: Sentry Error Tracking
# Get your DSN from: https://sentry.io/settings/[organization]/projects/[project]/keys/
SENTRY_DSN=
# Optional: Set Git SHA for release tracking
GIT_SHA=

# TASK-007: Scout APM
# Get your key from: https://scoutapm.com/
SCOUT_KEY=

# Payment Gateways (Trust as a Service)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Chat IA - OpenRouter & Hardening Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DO NOT EXPOSE AI_API_KEY in the frontend or NEXT_PUBLIC_* variables.
AI_PROVIDER=openrouter
AI_MODEL=openai/gpt-4o-mini
AI_API_KEY=sk-or-v1-...
AI_BASE_URL=https://openrouter.ai/api/v1
AI_HTTP_REFERER=https://www.avaliasolar.com.br
AI_APP_TITLE=Avalia Solar

# Chat control flags (backend only)
CHAT_ENABLED=true
CHAT_CAPTURE_LEADS_ENABLED=true
CHAT_POSTHOG_TRACKING_ENABLED=true
CHAT_INSIGHTS_ENABLED=true
CHAT_MAX_MESSAGES_PER_SESSION=50
CHAT_RATE_LIMIT_PER_MINUTE=30

# Commercial notifications (Slack integration)
SLACK_CHAT_LEADS_WEBHOOK_URL=https://hooks.slack.com/services/...

