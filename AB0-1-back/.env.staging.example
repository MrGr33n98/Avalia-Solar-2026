# ==============================================================================
# AB0-1 Backend - Staging Environment Variables Example
# ==============================================================================
# Start from .env.production.example and override staging-specific values.

RAILS_ENV=production
APP_HOST=https://staging-api.avaliasolar.com.br
ACTIVE_STORAGE_HOST=https://staging-api.avaliasolar.com.br
NEXT_REVALIDATE_URL=https://staging.avaliasolar.com.br/api/revalidate
NEXT_REVALIDATE_SECRET=generate_a_long_random_shared_secret
ALLOWED_HOSTS=staging-api.avaliasolar.com.br
G4_ANALYTICS_ENABLED=true
G4_ANALYTICS_STRICT_MODE=true
