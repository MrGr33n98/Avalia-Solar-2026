#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

cd "${BACKEND_DIR}"

exec docker compose \
  -f docker-compose.dev.yml \
  exec \
  -T \
  -e RAILS_ENV=development \
  app \
  bundle exec rails ai:serve
