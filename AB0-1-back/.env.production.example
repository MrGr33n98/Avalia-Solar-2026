# ==============================================================================
# AB0-1 Backend - Production Environment Variables Example
# ==============================================================================
# Copy this file to .env.production and fill in the actual values.
# NEVER commit the actual .env.production file to version control.

# ------------------------------------------------------------------------------
# 1. Rails / Application Core
# ------------------------------------------------------------------------------
RAILS_ENV=production
# Mandatory: Secret key base for sessions, cookies, and JWT authentication (TASK-012)
SECRET_KEY_BASE=your_production_secret_key_base_here
# Optional: Rails Master Key (if using credentials.yml.enc)
# RAILS_MASTER_KEY=your_rails_master_key_here

# Puma / Concurrency
PORT=3001
RAILS_MAX_THREADS=10
RAILS_MIN_THREADS=5
RAILS_LOG_TO_STDOUT=true
# RAILS_SERVE_STATIC_FILES=false

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------------------------
# You can use DATABASE_URL or individual POSTGRES_* variables (see config/database.yml)
# DATABASE_URL=postgresql://user:password@host:5432/db_name
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_PORT=5432
POSTGRES_DB=ab0_production

# ------------------------------------------------------------------------------
# 3. Redis / Sidekiq / Cache
# ------------------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_DRIVER=ruby
# SIDEKIQ_CONCURRENCY=10

# ------------------------------------------------------------------------------
# 4. Application URLs & CORS
# ------------------------------------------------------------------------------
# The host where the API is running (used for links in emails and ActiveStorage)
APP_HOST=https://api.avaliasolar.com.br
# Comma-separated list of allowed backend hosts (Host Authorization)
ALLOWED_HOSTS=api.avaliasolar.com.br
# Primary frontend origin (used in Devise mailers and CORS)
FRONTEND_ORIGIN=https://www.avaliasolar.com.br
# Compatibility alias used by older mailers and OAuth callbacks
FRONTEND_URL=https://www.avaliasolar.com.br
# Comma-separated list of origins for CORS
CORS_ORIGINS=https://www.avaliasolar.com.br,https://admin.avaliasolar.com.br
# ADDITIONAL_ALLOWED_ORIGINS=https://another-domain.com

# ------------------------------------------------------------------------------
# 5. Mailer (SMTP / Brevo)
# ------------------------------------------------------------------------------
MAILER_FROM_EMAIL=noreply@avaliasolar.com.br
SMTP_ADDRESS=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_DOMAIN=avaliasolar.com.br
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

# Optional Mailer Behavior
# SMTP_RAISE_DELIVERY_ERRORS=false
# ENABLE_EMAIL_INTERCEPTOR=false
# SAFE_EMAIL_DOMAINS=example.com,test.com
# SKIP_EMAILS_IN_ADMIN_APPROVE=false

# ------------------------------------------------------------------------------
# 6. Storage (DigitalOcean Spaces / S3 Compatible)
# ------------------------------------------------------------------------------
# ACTIVE_STORAGE_SERVICE: 'local' or 'spaces'
ACTIVE_STORAGE_SERVICE=spaces
SPACES_ACCESS_KEY_ID=your_access_key
SPACES_SECRET_ACCESS_KEY=your_secret_key
SPACES_REGION=nyc3
SPACES_BUCKET=avalia-solar-assets
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# ------------------------------------------------------------------------------
# 7. Monitoring & Observability
# ------------------------------------------------------------------------------
# SENTRY_DSN=https://your_sentry_dsn
# SENTRY_PROFILES_SAMPLE_RATE=0.1
# SCOUT_KEY=your_scout_apm_key
# SCOUT_MONITOR=true
# LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 8. Authentication & External Services
# ------------------------------------------------------------------------------
# Google OAuth
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Financial Gateway (Integrations)
# FINANCIAL_GATEWAY_URL=https://api.gateway.com
# FINANCIAL_GATEWAY_TOKEN=your_gateway_token

# ------------------------------------------------------------------------------
# 9. Security & Administration
# ------------------------------------------------------------------------------
# Comma-separated list of IPs to block (Rack::Attack)
# BLOCKED_IPS=1.2.3.4,5.6.7.8

# Seeds (used for initial setup via db:seed)
# SEED_ADMIN_EMAIL=admin@avaliasolar.com.br
# SEED_ADMIN_PASSWORD=secure_initial_password

# ------------------------------------------------------------------------------
# 10. DevOps Metadata
# ------------------------------------------------------------------------------
# GIT_SHA=current_git_commit_hash
# HOSTNAME=server_hostname
